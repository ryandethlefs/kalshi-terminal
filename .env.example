# Copy this to .env, then fill it in.

# From Kalshi: Account > API Keys. This is the key ID, a UUID.
KALSHI_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the .pem private key Kalshi gave you when you made the key.
# Kalshi shows it once. If you lost it, make a new key.
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Production. Use https://external-api.demo.kalshi.co to paper trade first.
KALSHI_BASE_URL=https://external-api.kalshi.com

PORT=8787

# Pyth locked their price API behind a key on 26 August 2026. Without this you
# get Kalshi data but no live price, so no fair value and no trade calls.
# Sign up at Pyth Terminal. A free trial is included.
PYTH_API_KEY=
